# Copy to .env.local for the two developer scripts, `npm run setup:notion` and
# `npm run check:notion`. The app does not use this file: you paste the token
# and the database link into it, under "Sync with Notion".

# Create an internal integration at https://www.notion.so/my-integrations
# Copy the "Internal Integration Secret" here.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The page the tasks database should live under.
# Open the parent page in Notion, "Copy link", and paste the link here.
# Only needed when running `npm run setup:notion`.
NOTION_PARENT_PAGE_ID=

# Printed by `npm run setup:notion`. Read by `npm run check:notion`.
NOTION_DATABASE_ID=
