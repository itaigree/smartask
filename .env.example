# Create an internal integration at https://www.notion.so/my-integrations
# Copy the "Internal Integration Secret" here.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The page the tasks database should live under.
# Open the parent page in Notion, "Copy link", take the 32-char id at the end.
# Only needed when running `npm run setup:notion`.
NOTION_PARENT_PAGE_ID=

# Printed by `npm run setup:notion`. Required by the app at runtime.
NOTION_DATABASE_ID=

# Optional, Phase 8. With no key the app uses keyword rules.
ANTHROPIC_API_KEY=
